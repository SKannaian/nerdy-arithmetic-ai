{
  "hosting": {
    "public": "test",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server.py",
      "requirements.txt",
      "start.bat"
    ],
    "rewrites": [
      {
        "source": "/chat",
        "function": "chat",
        "region": "us-central1"
      },
      {
        "source": "/health",
        "function": "health",
        "region": "us-central1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "nerdy-hackathon-suite",
      "runtime": "python312"
    }
  ]
}
